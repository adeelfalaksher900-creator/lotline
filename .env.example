# Optional persistent FalkorDB (use rediss:// for remote TLS connections)
# FALKORDB_URL=redis://localhost:6379
# Set one stable random secret for hosted deployments. Never commit its value.
# LOTLINE_SESSION_SECRET=
# Optional language-model planner. Without it, the UI labels the local router.
# LOTLINE_PLANNER_URL=https://YOUR-PLANNER.workers.dev/plan
# LOTLINE_PLANNER_KEY=
